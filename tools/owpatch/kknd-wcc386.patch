+static  bool    KKNDSingleExit( block *cond_blk )
+/* true if no loop block other than cond_blk leaves the loop */
+{
+    block       *blk;
+    block_num   i;
+
+    for( blk = Loop; blk != NULL; blk = blk->u.loop ) {
+        if( blk == cond_blk )
+            continue;
+        if( _IsBlkAttr( blk, BLK_RETURN ) )
+            return( false );
+        for( i = 0; i < blk->targets; ++i ) {
+            if( (blk->edge[i].flags & BEF_DEST_IS_BLOCK) == 0 )
+                return( false );
+            if( !_IsBlkAttr( blk->edge[i].destination.u.blk, BLK_IN_LOOP ) )
+                return( false );
+        }
+    }
+    return( true );
+}
